# nginx for the Sage User Panel (Docker). ${API_UPSTREAM} is filled in when the container starts.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 20m;

    # Docker's DNS. With the address in a variable nginx looks the API container up again (every 10 s) instead of
    # keeping the address it had at start: a recreated API container gets a new address, and the old one could
    # meanwhile belong to the other API.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # API calls go to the API container on the same address as the panel (no CORS needed).
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Always fetch the newest index.html and settings; the hashed JS / CSS files can be cached.
    location = /index.html        { add_header Cache-Control "no-store"; }
    location = /app-settings.json { add_header Cache-Control "no-store"; }

    # Angular routes (e.g. /sales/list after a refresh) get index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
