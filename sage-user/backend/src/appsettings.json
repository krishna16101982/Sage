{
  "JwtIssuerOptions": {
    "Issuer": "sage.user",
    "Audience": "sage.user.app",
    "SecurityKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "DatabaseSettings": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3
  },
  "AuthSettings": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshCookieSecure": true,
    "RefreshCookieSameSite": "Lax",
    "PasswordResetMinutes": 30,
    "FrontendBaseUrl": "http://localhost:4300"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "FromAddress": "",
    "FromName": "Sage Sales",
    "TimeoutSeconds": 30
  },
  "RateLimiting": { "AuthPermitPerMinute": 30 },
  "Cors": { "AllowedOrigins": [] },
  "Serilog": {
    "FilePath": "logs",
    "FileName": "SageUserApi",
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
