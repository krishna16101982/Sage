{
  "JwtIssuerOptions": {
    "Issuer": "sage.user",
    "Audience": "sage.user.app",
    "SecurityKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "DatabaseSettings": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3
  },
  "AuthSettings": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshCookieSecure": true,
    "RefreshCookieSameSite": "Lax"
  },
  "RateLimiting": { "AuthPermitPerMinute": 30 },
  "Cors": { "AllowedOrigins": [] },
  "Serilog": {
    "FilePath": "logs",
    "FileName": "SageUserApi",
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
