<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- User Panel API. Shares only sage-common-lib (and the database) with the Admin API. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\sage-admin\sage-common-lib\src\SageCommonLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Shared with the Admin API: one "dotnet user-secrets set Email:Password" serves both. -->
    <UserSecretsId>875c9add-6ed8-4d26-b7c7-ea2a286016fd</UserSecretsId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
