<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- User Panel API. Shares only sage-common-lib (and the database) with the Admin API. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\sage-admin\sage-common-lib\src\SageCommonLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Shared with the Admin API: one "dotnet user-secrets set Email:Password" serves both. -->
    <UserSecretsId>875c9add-6ed8-4d26-b7c7-ea2a286016fd</UserSecretsId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Order form PDF: logos (and optional fonts) next to the app. -->
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Machine-specific settings stay on each machine: never published, so a server keeps its own appsettings.Local.json. -->
    <Content Update="appsettings.Local.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
