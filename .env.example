# Sage Docker settings. Copy to .env next to docker-compose.yml and fill in. NEVER commit .env.

# Images: built here (docker compose build) or pulled from GitHub (docker compose pull).
REGISTRY=ghcr.io/krishna16101982
IMAGE_TAG=latest
# Panel build: dev | qat | production (only used when building here).
PANEL_BUILD=qat

# Ports on this machine (IIS uses 8081-8084, so Docker uses 9081 / 9082).
USER_PANEL_PORT=9081
ADMIN_PANEL_PORT=9082

# Addresses users open (used in password-reset email links).
USER_PANEL_URL=http://localhost:9081
ADMIN_PANEL_URL=http://localhost:9082

# Existing SQL Server. From a container, "localhost" is the container itself: use the server's IP (or
# host.docker.internal on Docker Desktop) and a fixed TCP port (set SQLEXPRESS to port 1433 in SQL Server
# Configuration Manager). Avoid ';' in the password.
DB_CONNECTION=Server=10.10.61.100,1433;Database=SageAdmin_Dev;User Id=sage_user;Password=CHANGE_ME;TrustServerCertificate=true

# Two different random secrets, at least 32 characters each.
ADMIN_JWT_KEY=CHANGE_ME_admin_random_secret_at_least_32_chars
USER_JWT_KEY=CHANGE_ME_user_random_secret_at_least_32_chars

# Plain http: false. Set true once the panels are served over https.
COOKIE_SECURE=false

# Optional: password-reset emails (leave EMAIL_HOST empty to turn email off).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
